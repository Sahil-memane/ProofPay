# Google Gemini API Key
GOOGLE_API_KEY=your_gemini_api_key_here

# LLM Model Configuration
GEMINI_MODEL=gemini-2.5-flash

# Policy Limits
MIN_PROJECT_BUDGET=50.0
MAX_PROJECT_BUDGET=50000.0
MIN_MILESTONE_AMOUNT=20.0
MAX_RELEASE_PERCENTAGE=0.80
SUPPORTED_CURRENCIES=USD,EUR,GBP,CAD,AUD

# Scoping Agent Limits
MIN_MILESTONES=2
MAX_MILESTONES=6
MIN_HARD_CRITERIA_RATIO=0.70

# Persistent local database (no hosted database account required)
DATABASE_URL=sqlite:///./data/proofpay.db

# Environment Mode
ENVIRONMENT=development


# Optional: GitHub token for higher API limits/private repository checks
GITHUB_TOKEN=
