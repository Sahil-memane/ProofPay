# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://proofpay:proofpay@localhost:5432/proofpay
DATABASE_URL_SYNC=postgresql://proofpay:proofpay@localhost:5432/proofpay

# ── App ───────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8000
DEMO_MODE=true
SIMULATOR_ENABLED=true
INTERNAL_TICK_TOKEN=dev-tick-token-change-in-prod
POLICY_SIGNING_KEY=dev-signing-key-change-in-prod

# ── PayPal ────────────────────────────────────────────────────────────────────
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# rest | mcp | fake  (use "fake" for local dev/CI without sandbox credentials)
PAYPAL_EXEC_MODE=fake

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL_CHEAP=gpt-4o-mini
LLM_MODEL_QA=gpt-4o
LLM_DAILY_CAP=100

# ── GitHub (read-only token for Verifier collector) ───────────────────────────
GITHUB_TOKEN=

# ── Email ─────────────────────────────────────────────────────────────────────
# outbox = store in DB and show in UI (default for demo)
# smtp   = real SMTP delivery
EMAIL_MODE=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
AGGRID_LICENSE_KEY=
